# ---------------------------------------------------------------------------
# Preset: every sport, every game market, every player prop.
#
# Sized for a 100,000/month plan. Breadth and sampling density trade off
# against each other exactly, so this file is the widest scope that still
# leaves enough repeat visits for a price to be seen moving:
#
#   credits/day = props_factor x sports_in_range x 86400/POLL_INTERVAL_SECONDS
#                 + sports x 86400/EVENTS_REFRESH_SECONDS
#
# With 95 sports, ~15 of them have a fixture inside the tracking lead at any
# moment, and props double every odds call:
#
#   poll  600s, props   ->  141k/month, 2.0 samples per game
#   poll  900s, props   ->   98k/month, 1.3 samples per game
#   poll  450s, no props->   98k/month, 2.7 samples per game
#
# A line needs at least two samples before kick-off to be seen moving, so the
# 900s row cannot signal at any threshold. This file uses 600s and a daily cap
# that stops the month being spent in a week; MAX_REQUESTS_PER_DAY is the
# guard rail, not the plan.
#
# If you would rather have dense sampling than every sport, cut SPORTS to the
# dozen you care about: 12 sports at a 300s poll with props costs 71k/month
# and gives 4 samples per game, and at 120s without props, 88k and 10 samples.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=parlay-api
ODDS_FORMAT=american

# Every game market the API accepts, learned from its own rejection reply and
# cached (MARKET_KEYS_TTL_SECONDS) so a restart does not pay to relearn it.
FEATURED_MARKETS=all
# Every prop key the sport offers. This doubles the cost of every odds call:
# props come from a second endpoint, one request per sport per poll.
PROP_MARKETS=all
MARKET_KEYS_TTL_SECONDS=604800

BOOKMAKERS=Bet365,DraftKings
SPORTS=all
LEAGUES=
MARKETS=
OUTCOMES=
MAX_ALERTS_PER_POLL=20
PER_EVENT_ODDS=false

WINDOW_START_SECONDS=600
WINDOW_END_SECONDS=0
BASELINE_LEAD_SECONDS=1200
# first-seen compares against the first price recorded at T-20, so a line
# does not need to exist before the window to be able to signal.
BASELINE_MODE=first-seen
MIN_DROP_PCT=2.0
MIN_ODDS=1.05

# 600s over a 1200s lead is two samples per game -- the minimum that can
# show movement. Lower it and you buy sampling density; the table above
# says what it costs.
POLL_INTERVAL_SECONDS=600
IDLE_POLL_INTERVAL_SECONDS=900
# Kick-off times do not move: four refreshes a day cost 11k/month, hourly
# would cost 68k of the same 100k.
EVENTS_REFRESH_SECONDS=21600
MAX_REQUESTS_PER_HOUR=600
# 100,000/month is 3,300 a day sustained. 5,000 allows a busy Saturday to
# borrow from a quiet Tuesday without letting a runaway spend the month.
MAX_REQUESTS_PER_DAY=5000

DB_PATH=/var/lib/odds-watcher/odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false

# ---------------------------------------------------------------------------
# Secrets -- fill these in, and never commit this file once you have.
# ---------------------------------------------------------------------------
ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
