# ---------------------------------------------------------------------------
# Provider
# ---------------------------------------------------------------------------
# odds-api-io   - api2.odds-api.io, metered per request
# the-odds-api  - api.the-odds-api.com/v4, metered as markets x regions
# parlay-api    - parlay-api.com, metered per request (free tier 1,000/month).
#                 One request returns every event for a sport, so a poll costs
#                 one request per sport regardless of how many games are on.
ODDS_PROVIDER=odds-api-io

# How the provider quotes prices: american | decimal | auto.
# ParlayAPI quotes American (-130, +120); it is converted to decimal on the way in.
ODDS_FORMAT=american

# The Odds API only. Regions to query (us | uk | eu | au, comma separated) —
# each extra region multiplies the cost of every call.
REGIONS=us
# Featured markets come from one call covering the whole sport.
FEATURED_MARKETS=h2h,spreads,totals
# Player props are only available per fixture, and cost markets x regions for
# EACH fixture. Set to "all" to request every market key the sport offers —
# the usable set is discovered once and cached (MARKET_KEYS_TTL_SECONDS).
# Read the credit arithmetic in the README first: all-props at a 60s poll is
# several million credits a month. Leave empty for featured markets only.
PROP_MARKETS=
MARKET_KEYS_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Credentials (required)
# ---------------------------------------------------------------------------
# https://odds-api.io/#pricing  ->  free tier API key
ODDS_API_KEY=
# @BotFather -> /newbot -> the token it hands back
TELEGRAM_BOT_TOKEN=
# Message your bot once, then: python -m odds_watcher chat-id
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# What to watch
# ---------------------------------------------------------------------------
# The free tier allows exactly 2 selected bookmakers. These are the API's own
# identifiers, not necessarily lowercase names — list them with:
#   python -m odds_watcher bookmakers --search bet
BOOKMAKERS=Bet365,DraftKings
# Discover the exact identifiers with: python -m odds_watcher sports --all
# On The Odds API each competition is its own sport key, and several can be
# watched at once — each costs its own featured call per poll.
#   SPORTS=baseball_mlb,soccer_epl,soccer_spain_la_liga
SPORTS=baseball
# Optional: restrict to specific leagues. Discover them with:
#   python -m odds_watcher leagues --search premier
# Strongly recommended — "all football" is thousands of fixtures worldwide.
LEAGUES=
# Which markets to watch. Empty means every market the API returns, including
# player props. List them for your sport with:
#   python -m odds_watcher markets
# Matching is case-insensitive substring; prefix an entry with - to exclude,
# e.g. MARKETS=Totals,-F5 for full-game totals only.
MARKETS=

# Restrict which sides may alert, e.g. over,under to watch totals only.
# Empty = every side.
OUTCOMES=

# Ceiling on messages from a single poll. Watching every market and player
# prop can surface hundreds of drops at once; the largest are sent and the
# rest are logged. Raise MIN_DROP_PCT rather than this if you get too many.
MAX_ALERTS_PER_POLL=20

# Player props are documented as available one fixture at a time, so the
# batched endpoint may return only game markets. Run `python -m odds_watcher
# props` to compare the two on your account before enabling this: it costs one
# request per fixture per poll instead of one per twenty.
PER_EVENT_ODDS=false

# ---------------------------------------------------------------------------
# The alert rule
# ---------------------------------------------------------------------------
# Signals fire only for drops inside this window: 10 minutes before kick-off
# down to kick-off itself.
WINDOW_START_SECONDS=600
WINDOW_END_SECONDS=0
# Start recording prices this long before kick-off so a reference price exists
# by the time the window opens. Leave it unset and it is derived from your poll
# interval (WINDOW_START_SECONDS + 3 x POLL_INTERVAL_SECONDS, at least 900),
# which is usually what you want — a longer lead only spends requests on prices
# that are discarded. If you do set it, it must be at least
# WINDOW_START_SECONDS + 2 x POLL_INTERVAL_SECONDS.
# Watch period: prices are recorded from 20 minutes before kick-off, so the
# reference is the last price seen between 20 and 11 minutes out.
BASELINE_LEAD_SECONDS=1200
# How the reference price is chosen:
#   window-entry - the last price before the window opens; only movement
#                  inside WINDOW_START..WINDOW_END can signal.
#   first-seen   - the first price recorded for a line is the reference, and
#                  any drop from the start of tracking until kick-off signals.
#                  Use this to be alerted on every successive drop from when
#                  tracking begins; BASELINE_LEAD_SECONDS then sets how early
#                  that is, and WINDOW_START_SECONDS is not used.
BASELINE_MODE=window-entry

# Minimum shortening, in percent, measured against the reference price. After
# a signal the reference resets to the signalled price, so a line that keeps
# sliding produces a further signal for each additional MIN_DROP_PCT.
MIN_DROP_PCT=10.0
# Ignore very short prices, where a % move is meaningless.
MIN_ODDS=1.05

# ---------------------------------------------------------------------------
# Polling and free-tier budget (100 requests/hour, 500/day)
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
IDLE_POLL_INTERVAL_SECONDS=300
EVENTS_REFRESH_SECONDS=900
MAX_REQUESTS_PER_HOUR=90
MAX_REQUESTS_PER_DAY=450

# ---------------------------------------------------------------------------
# Plumbing
# ---------------------------------------------------------------------------
DB_PATH=odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false
