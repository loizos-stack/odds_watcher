# ---------------------------------------------------------------------------
# All sports, game markets everywhere, player props where they are wanted.
#
# The conflict this resolves: props cost a SECOND request per sport per poll,
# so across 388 sports they are 60% of the bill. Measured on this account:
#
#   all sports + props everywhere, 3 samples   167k/month   over a 100k plan
#   all sports, no props at all,   3 samples    89k/month   but no prop alerts
#   all sports, props on MLB only, 3 samples    98k/month   <- this file
#
# PROP_SPORTS is what makes the third row possible: game markets still cover
# every sport, and only the named ones pay for props.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=parlay-api
# Decimal throughout: requested from the API in decimal, and shown in decimal
# in the alert. No conversion happens on the way in, so the numbers in the
# message are the numbers the book published.
ODDS_FORMAT=decimal

FEATURED_MARKETS=all
PROP_MARKETS=all
# Props only for these. Empty would mean every sport -- and 167k/month.
PROP_SPORTS=baseball_mlb,americanfootball_nfl,basketball_nba
MARKET_KEYS_TTL_SECONDS=604800

BOOKMAKERS=bet365,draftkings
SPORTS=all
LEAGUES=
MARKETS=
OUTCOMES=
MAX_ALERTS_PER_POLL=20
PER_EVENT_ODDS=false

# Thirty minutes of tracking, three looks at every fixture.
BASELINE_LEAD_SECONDS=1800
BASELINE_MODE=first-seen
WINDOW_START_SECONDS=600
WINDOW_END_SECONDS=0

# The threshold stays on the American scale even though prices are displayed
# in decimal: "10%" is -110 -> -121, which is only 4.33% in decimal. Set
# DROP_METRIC=decimal and MIN_DROP_PCT=4.3 if you would rather the number in
# the message and the number in the threshold be on the same scale.
DROP_METRIC=american
MIN_DROP_PCT=10.0
# After the first signal, every further step down is reported.
FOLLOW_UP_DROP_PCT=0.0
MIN_ODDS=1.05

POLL_INTERVAL_SECONDS=600
IDLE_POLL_INTERVAL_SECONDS=900
# 388 sports is 388 requests per refresh -- daily is 388/day, six-hourly would
# be 1,552/day, or half the plan spent before a single price is read.
EVENTS_REFRESH_SECONDS=86400
MAX_REQUESTS_PER_HOUR=400
# ~98k/month at 3,300 a day. The cap is the guard rail, not the plan.
MAX_REQUESTS_PER_DAY=3300

DISPLAY_TIMEZONE=Asia/Nicosia
DB_PATH=/var/lib/odds-watcher/odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false

ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
