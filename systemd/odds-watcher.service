[Unit]
Description=Telegram alerts for late odds drops (bet365 / betano)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=odds
WorkingDirectory=/opt/odds_watcher
EnvironmentFile=/opt/odds_watcher/.env
ExecStart=/usr/bin/python3 -m odds_watcher run
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
