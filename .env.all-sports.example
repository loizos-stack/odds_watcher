# ---------------------------------------------------------------------------
# Preset: every sport, every game market, every player prop.
#
# Cost per day is almost entirely decided by ONE number -- how many times each
# fixture is priced before kick-off:
#
#   credits/day  ~=  props_factor x sports_in_range x samples_per_game
#   samples_per_game  =  BASELINE_LEAD_SECONDS / POLL_INTERVAL_SECONDS
#
# Widening the lead and shortening the poll are the same lever pulled from two
# ends: a longer lead puts more sports in range at once, a shorter poll visits
# each one more often, and both raise samples_per_game at the same rate.
#
# The floor is set by config validation: BASELINE_LEAD_SECONDS must be at
# least WINDOW_START_SECONDS + 2 x POLL_INTERVAL_SECONDS, so no valid setup
# samples a fixture fewer than about 2.5 times. On ~95 sports, with props
# doubling every odds call, that floor already costs roughly 160-200k a month
# -- more than a 100,000 plan. Be deliberate about which of the three you give
# up:
#
#   all sports + props, poll 600s / lead 1800s   ~200k/month, 3.0 samples
#   all sports, no props, poll 900s / lead 2400s  ~81k/month, 2.7 samples
#   ~45 sports + props, poll 600s / lead 1800s   ~100k/month, 3.0 samples
#
# This file is the first row -- the full scope, as asked for. MAX_REQUESTS_PER_DAY
# holds it to the plan, which means it goes quiet once the day's share is
# spent. Read the "cost estimate" line the watcher logs on its first poll:
# it counts your real slate rather than these approximations.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=parlay-api
ODDS_FORMAT=american

# Every game market the API accepts, learned from its own rejection reply and
# cached (MARKET_KEYS_TTL_SECONDS) so a restart does not pay to relearn it.
FEATURED_MARKETS=all
# Every prop key the sport offers. This doubles the cost of every odds call:
# props come from a second endpoint, one request per sport per poll.
PROP_MARKETS=all
MARKET_KEYS_TTL_SECONDS=604800

BOOKMAKERS=Bet365,DraftKings
SPORTS=all
LEAGUES=
MARKETS=
OUTCOMES=
MAX_ALERTS_PER_POLL=20
PER_EVENT_ODDS=false

WINDOW_START_SECONDS=600
WINDOW_END_SECONDS=0
# Must be >= WINDOW_START_SECONDS + 2 x POLL_INTERVAL_SECONDS, or the
# config is rejected: a fixture that enters the window unpriced can never
# alert, so the tool refuses to pretend otherwise.
BASELINE_LEAD_SECONDS=1800
# first-seen compares against the first price recorded at T-20, so a line
# does not need to exist before the window to be able to signal.
BASELINE_MODE=first-seen
MIN_DROP_PCT=2.0
MIN_ODDS=1.05

# Three samples per fixture: at T-30, T-20 and T-10. Lower this only
# together with BASELINE_LEAD_SECONDS -- see the floor described above.
POLL_INTERVAL_SECONDS=600
IDLE_POLL_INTERVAL_SECONDS=900
# Kick-off times do not move: four refreshes a day cost 11k/month, hourly
# would cost 68k of the same 100k.
EVENTS_REFRESH_SECONDS=21600
MAX_REQUESTS_PER_HOUR=600
# 100,000/month is 3,300 a day. This scope runs above that, so the cap is
# load-bearing: expect the watcher to fall silent late in the day until
# you narrow SPORTS or turn PROP_MARKETS off.
MAX_REQUESTS_PER_DAY=3300

DB_PATH=/var/lib/odds-watcher/odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false

# ---------------------------------------------------------------------------
# Secrets -- fill these in, and never commit this file once you have.
# ---------------------------------------------------------------------------
ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
