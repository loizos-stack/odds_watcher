# ---------------------------------------------------------------------------
# The stated rule, as a configuration.
#
#   "At 02:05 the Yankees host the Astros. From 01:44 we scan every market of
#    that game on bet365 and draftkings. A drop of 10% or more from the 01:44
#    price is a notification -- and if the line keeps dropping after that, we
#    want each further step too, whatever its size. -110 at 01:44, -121 at
#    01:55, -123 at 01:58 is two notifications."
#
# The setting that makes this work is DROP_METRIC=american. A bettor quotes
# -110 -> -121 as ten percent; in decimal the same move is 1.9091 -> 1.8264,
# a 4.33% drop. Measured in decimal, MIN_DROP_PCT=10 waits for -110 -> -158
# and never fires on anything you would call a ten percent move.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=parlay-api
ODDS_FORMAT=american

# Every game market, and every player prop -- the Cole strikeouts line is a
# prop, so PROP_MARKETS is not optional for this rule.
FEATURED_MARKETS=all
PROP_MARKETS=all
MARKET_KEYS_TTL_SECONDS=604800

BOOKMAKERS=bet365,draftkings
SPORTS=baseball_mlb
LEAGUES=
MARKETS=
OUTCOMES=
MAX_ALERTS_PER_POLL=20
PER_EVENT_ODDS=false

# 01:44 is 21 minutes before a 02:05 first pitch, and the reference is the
# price standing then -- so first-seen, with the lead set to 21 minutes.
BASELINE_LEAD_SECONDS=1260
BASELINE_MODE=first-seen
# Not used by first-seen, but must stay below BASELINE_LEAD_SECONDS.
WINDOW_START_SECONDS=600
WINDOW_END_SECONDS=0

# Ten percent of the American price, for the FIRST signal on a line.
DROP_METRIC=american
MIN_DROP_PCT=10.0
# Once a line has signalled, the question is no longer "is this a big move"
# but "has it stopped" -- so any further shortening is reported, measured from
# the price that last signalled. -110 -> -121 -> -123 sends two messages: one
# at 10.0%, one at 1.65%. Raise this if the follow-ups become noise.
FOLLOW_UP_DROP_PCT=0.0
MIN_ODDS=1.05

# Every two minutes: ten looks at each fixture between 01:44 and first pitch.
POLL_INTERVAL_SECONDS=120
IDLE_POLL_INTERVAL_SECONDS=900
EVENTS_REFRESH_SECONDS=21600
# One sport, so a poll is two requests (odds + props) and only while a game
# is inside the 21-minute lead. A full MLB slate costs a few hundred a day.
MAX_REQUESTS_PER_HOUR=120
MAX_REQUESTS_PER_DAY=1500

# Timestamps in messages are rendered in this zone, so 02:05 in the alert
# is the 02:05 you are reading on the board.
DISPLAY_TIMEZONE=Asia/Nicosia

DB_PATH=/var/lib/odds-watcher/odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false

ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
