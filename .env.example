# ---------------------------------------------------------------------------
# Credentials (required)
# ---------------------------------------------------------------------------
# https://odds-api.io/#pricing  ->  free tier API key
ODDS_API_KEY=
# @BotFather -> /newbot -> the token it hands back
TELEGRAM_BOT_TOKEN=
# Message your bot once, then: python -m odds_watcher chat-id
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# What to watch
# ---------------------------------------------------------------------------
# The free tier allows exactly 2 selected bookmakers. These are the API's own
# identifiers, not necessarily lowercase names — list them with:
#   python -m odds_watcher bookmakers --search bet
BOOKMAKERS=Bet365,Betano
SPORTS=football
# Optional: restrict to specific leagues. Discover them with:
#   python -m odds_watcher leagues --search premier
# Strongly recommended — "all football" is thousands of fixtures worldwide.
LEAGUES=
# Which markets to watch. Discover the exact names this API uses with:
#   python -m odds_watcher markets
# Matching is case-insensitive substring; prefix an entry with - to exclude.
# The default below tracks goals, corner and bookings totals, while excluding
# half-time variants, the handicap versions of those markets, and first-corner
# style bets. Empty = every market the API returns (noisy).
MARKETS=Totals,Corner,Booking,Card,-HT,-Handicap,-First

# Restrict which sides may alert. For totals you only want the over/under
# prices, never the home/away rows some markets also carry. Empty = all sides.
OUTCOMES=over,under

# ---------------------------------------------------------------------------
# The alert rule
# ---------------------------------------------------------------------------
# Alert only for drops happening between 10 minutes and 0 minutes before
# kick-off (i.e. the last 10 minutes).
WINDOW_START_SECONDS=600
WINDOW_END_SECONDS=0
# Start recording prices this long before kick-off so a reference price exists
# by the time the window opens. It only needs to clear WINDOW_START_SECONDS by
# a couple of polls — a longer lead just spends requests on prices that are
# discarded. Must be >= WINDOW_START_SECONDS + 2 x POLL_INTERVAL_SECONDS.
BASELINE_LEAD_SECONDS=900
# Minimum shortening, in percent, measured against the price at window entry.
MIN_DROP_PCT=5.0
# Ignore very short prices, where a % move is meaningless.
MIN_ODDS=1.05

# ---------------------------------------------------------------------------
# Polling and free-tier budget (100 requests/hour, 500/day)
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
IDLE_POLL_INTERVAL_SECONDS=300
EVENTS_REFRESH_SECONDS=900
MAX_REQUESTS_PER_HOUR=90
MAX_REQUESTS_PER_DAY=450

# ---------------------------------------------------------------------------
# Plumbing
# ---------------------------------------------------------------------------
DB_PATH=odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false
