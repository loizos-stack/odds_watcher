# ---------------------------------------------------------------------------
# Preset: one league, sampled densely. The one that fits a 1,000/month tier.
#
# Credits are not spent per game, they are spent per KICKOFF CLUSTER: one
# request returns every fixture for the sport, so six games kicking off at
# 15:00 cost the same as one. What actually multiplies is how often you look:
#
#   credits per cluster  =  tracking lead / poll interval
#                        =  1200s / 60s  =  20
#
# Plus the fixture refresh, which runs whether or not anything is on:
#
#   1 sport every 6h  =  4 a day  =  ~120 a month
#
# So 1,000 credits buys ~44 kickoff clusters a month, each watched every
# minute for the 20 minutes that matter. Watching 95 sports instead spends the
# same 1,000 credits in about four hours and samples each line once, which
# cannot produce a signal at any threshold.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=parlay-api
ODDS_FORMAT=american

FEATURED_MARKETS=all
PROP_MARKETS=
MARKET_KEYS_TTL_SECONDS=604800

BOOKMAKERS=Bet365,DraftKings,FanDuel
# One sport. Add a second only after checking the arithmetic above -- each one
# is its own request per poll AND its own fixture refresh.
SPORTS=soccer_epl
LEAGUES=
MARKETS=
OUTCOMES=

MAX_ALERTS_PER_POLL=20
PER_EVENT_ODDS=false

# 20 samples across the 20 minutes before kick-off, which is what it takes to
# see a line move rather than just to see it exist.
WINDOW_START_SECONDS=600
WINDOW_END_SECONDS=0
BASELINE_LEAD_SECONDS=1200
# first-seen compares against the first price recorded at T-20, so a line does
# not need to exist before the window to be able to signal.
BASELINE_MODE=first-seen
MIN_DROP_PCT=2.0
MIN_ODDS=1.05

POLL_INTERVAL_SECONDS=60
# Nothing in range: check back in a quarter of an hour. No odds calls are made
# while idle, only the occasional fixture refresh.
IDLE_POLL_INTERVAL_SECONDS=900
# Kick-off times do not move. Refreshing four times a day costs 120 credits a
# month; refreshing every 15 minutes would cost 2,880.
EVENTS_REFRESH_SECONDS=21600
MAX_REQUESTS_PER_HOUR=80
MAX_REQUESTS_PER_DAY=200

# On a VPS with the hardened systemd unit, /opt is read-only:
DB_PATH=/var/lib/odds-watcher/odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false

ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
