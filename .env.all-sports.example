# ---------------------------------------------------------------------------
# Preset: every sport, every game market, no player props.
#
# Sized for a ParlayAPI free-tier balance of a few hundred credits, so that a
# run lasts hours rather than minutes. Copy over your own .env, then put your
# three secrets back at the bottom.
#
# The cost has two halves, and they are metered on different clocks:
#
#   fixture refresh   one request per sport, for EVERY sport, each time the
#                     list goes stale -> 89 sports / 3600s = ~89 per hour
#   odds              one request per sport that has a fixture inside the
#                     tracking lead RIGHT NOW -- not per configured sport.
#                     A typical evening has ~8 -> 8 x 12 polls = ~96 per hour
#
# ~185 requests an hour in total, so ~4-5 hours on a 858-credit balance. The
# watcher prints its own estimate on the first poll; trust that over this
# comment, since it counts your actual slate.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=parlay-api
ODDS_FORMAT=american

# Every game market the API accepts, learned from its own rejection reply and
# cached (MARKET_KEYS_TTL_SECONDS) so a restart does not pay to relearn it.
FEATURED_MARKETS=all
# Props are off: they cost a second request per sport per poll, and on a small
# balance they buy less watching time than they are worth.
PROP_MARKETS=
MARKET_KEYS_TTL_SECONDS=86400

BOOKMAKERS=Bet365,DraftKings,FanDuel
SPORTS=all
LEAGUES=
MARKETS=
OUTCOMES=
MAX_ALERTS_PER_POLL=20
PER_EVENT_ODDS=false

# The alert rule: record from 20 minutes out, signal on a 2%+ shortening
# inside the last 10 minutes.
WINDOW_START_SECONDS=600
WINDOW_END_SECONDS=0
BASELINE_LEAD_SECONDS=1200
BASELINE_MODE=window-entry
MIN_DROP_PCT=2.0
MIN_ODDS=1.05

# 300s gives two pre-window samples and two chances inside the window, at a
# quarter the cost of the 60s default.
POLL_INTERVAL_SECONDS=300
IDLE_POLL_INTERVAL_SECONDS=900
# 3600s is the single biggest saving here: at the 900s default the fixture
# refresh alone costs 356 requests an hour.
EVENTS_REFRESH_SECONDS=3600
# Headroom over the ~185/hour estimate, so nothing is skipped mid-window.
MAX_REQUESTS_PER_HOUR=220
# The real guard rail: a hard stop before a small monthly balance is gone.
MAX_REQUESTS_PER_DAY=800

DB_PATH=odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false

# ---------------------------------------------------------------------------
# Secrets -- fill these in, and never commit this file once you have.
# ---------------------------------------------------------------------------
ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
