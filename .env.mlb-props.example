# ---------------------------------------------------------------------------
# MLB player props only. The narrowest useful configuration, and the one the
# original example describes: Gerrit Cole over 5.5 strikeouts, -110 at 01:44,
# -121 at 01:55.
#
# One sport, props only, so a poll is ONE request and only while a game is
# inside the tracking lead. A full MLB slate costs a few hundred a day against
# a 100,000 plan -- the budget stops being a constraint at this scope.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=parlay-api
ODDS_FORMAT=decimal

# Empty: no moneylines, spreads or totals. Props only.
FEATURED_MARKETS=
# Named explicitly rather than "all". MLB publishes a prop key per player per
# stat -- thousands of them -- and naming them all exceeds the provider's URL
# limit (HTTP 414). These are the stat lines themselves.
PROP_MARKETS=player_strikeouts,player_pitcher_strikeouts,player_hits,player_hits_allowed,player_singles,player_doubles,player_home_runs,player_total_bases,player_runs,player_rbis,player_hits_runs_rbis
# Empty: every configured sport gets props, and there is only one.
PROP_SPORTS=
MARKET_KEYS_TTL_SECONDS=604800

BOOKMAKERS=bet365,draftkings
SPORTS=baseball_mlb
LEAGUES=
MARKETS=
OUTCOMES=
MAX_ALERTS_PER_POLL=20
PER_EVENT_ODDS=false

# Track from 40 minutes out, allow signals from 30 minutes out. Wider than the
# earlier settings because one sport costs almost nothing to watch.
BASELINE_LEAD_SECONDS=2400
WINDOW_START_SECONDS=1800
WINDOW_END_SECONDS=0
# Each price is compared with the one recorded before it.
BASELINE_MODE=last-seen

# Decimal throughout so the odds shown and the drop % are on one scale.
# 4.3% decimal is the same move as 10% on the American price (-110 -> -121).
DROP_METRIC=decimal
MIN_DROP_PCT=4.3
FOLLOW_UP_DROP_PCT=0.0
MIN_ODDS=1.05

# With last-seen the poll interval IS the comparison interval: this asks for a
# 10% move inside five minutes.
POLL_INTERVAL_SECONDS=300
IDLE_POLL_INTERVAL_SECONDS=900
EVENTS_REFRESH_SECONDS=21600
MAX_REQUESTS_PER_HOUR=200
MAX_REQUESTS_PER_DAY=1000

DISPLAY_TIMEZONE=Asia/Nicosia
DB_PATH=/var/lib/odds-watcher/odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false

ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
