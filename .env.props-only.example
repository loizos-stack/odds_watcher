# ---------------------------------------------------------------------------
# Player props only, every sport, both books, any 10% shortening between two
# consecutive scans.
#
#   "only player props for all sports. any dropping odds on bet365 and
#    draftkings over 10% american odds from the last price seen"
#
# Two settings make this cheap enough to leave running:
#
#   FEATURED_MARKETS=   game markets are not fetched at all, so a sport in
#                       range costs ONE request per poll rather than two
#   (automatic)         a sport whose props endpoint returns nothing is
#                       recorded and not asked again for MARKET_KEYS_TTL_
#                       SECONDS -- most of the 388 sports have no props, and
#                       each was a request per poll to be told so
#
# After the first few polls only the sports that actually price props are
# still being asked, which is a handful rather than eighteen.
# ---------------------------------------------------------------------------
ODDS_PROVIDER=parlay-api
ODDS_FORMAT=american

# Empty: no game markets. Moneylines, spreads and totals are not fetched.
FEATURED_MARKETS=
PROP_MARKETS=all
# Empty: every sport is offered props, and the ones without them drop out on
# their own after the first poll that asks.
PROP_SPORTS=
MARKET_KEYS_TTL_SECONDS=604800

BOOKMAKERS=bet365,draftkings
SPORTS=all
LEAGUES=
MARKETS=
OUTCOMES=
MAX_ALERTS_PER_POLL=20
PER_EVENT_ODDS=false

# last-seen: each price is compared with the one recorded before it, so any
# 10% step between two consecutive scans signals -- not a cumulative move from
# a fixed opening price. This is the most sensitive of the three rules, and
# the one that matches "from the last price seen".
BASELINE_MODE=last-seen
# Prices are recorded from 30 minutes out and may signal from 20 minutes out.
# last-seen alerts only inside WINDOW_START..WINDOW_END, so that window is
# opened wide rather than left at the last ten minutes.
BASELINE_LEAD_SECONDS=1800
WINDOW_START_SECONDS=1200
WINDOW_END_SECONDS=0

# Ten percent of the American price: -110 -> -121. In decimal that same move
# is 4.33%, so the scale is not interchangeable with the threshold.
DROP_METRIC=american
MIN_DROP_PCT=10.0
# Each step is measured against the previous scan, so there is no separate
# follow-up rule to apply -- every further step is simply the next comparison.
FOLLOW_UP_DROP_PCT=0.0
MIN_ODDS=1.05

# Five minutes: with last-seen, the poll interval IS the comparison interval.
# A 10% step is a big move to make in five minutes, which is the point.
POLL_INTERVAL_SECONDS=300
IDLE_POLL_INTERVAL_SECONDS=900
EVENTS_REFRESH_SECONDS=86400
# One refresh is one request per sport in a burst; the cap has to clear it.
MAX_REQUESTS_PER_HOUR=700
MAX_REQUESTS_PER_DAY=3300

DISPLAY_TIMEZONE=Asia/Nicosia
DB_PATH=/var/lib/odds-watcher/odds_watcher.db
LOG_LEVEL=INFO
DRY_RUN=false

ODDS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
